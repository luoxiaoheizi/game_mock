:host{display:inline-block}.die{width:110rpx;height:110rpx;padding:16rpx;background:linear-gradient(145deg,#fffef8,#e4ddc8);border-radius:22rpx;box-shadow:0 10rpx 0 #c7bea5,0 18rpx 20rpx #08231e70;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);gap:5rpx;box-sizing:border-box}.pip{width:100%;height:100%;border-radius:50%;background:transparent}.visible{background:#193d34;box-shadow:inset 0 2rpx 2rpx #091c1780}.red.visible{background:#bd5944}.rolling{animation:tumble .22s ease-in-out infinite alternate}@keyframes tumble{from{transform:translateY(0) rotate(-14deg)}to{transform:translateY(-24rpx) rotate(22deg)}}
