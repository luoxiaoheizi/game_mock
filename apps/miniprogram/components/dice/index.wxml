<view wx:if="{{spatial}}" class="spatial-die" aria-label="骰子正面 {{value}} 点"><view class="dice-cube {{rolling ? 'cube-rolling' : ''}}"><view class="dice-core" aria-hidden="true"><view wx:for="{{sides}}" wx:key="i" class="core-face face-{{item.i}}"></view></view><view wx:for="{{sides}}" wx:key="i" wx:for-item="face" class="cube-face face-{{face.i}}"><view wx:for="{{face.dots}}" wx:key="i" class="pip {{item.on ? 'visible' : ''}} {{face.value === 1 || face.value === 4 ? 'red' : ''}}"></view></view></view></view>
<view wx:else class="die {{rolling ? 'rolling' : ''}}" aria-label="骰子 {{value}} 点"><view wx:for="{{dots}}" wx:key="i" class="pip {{item.on ? 'visible' : ''}} {{value === 1 || value === 4 ? 'red' : ''}}"></view></view>
