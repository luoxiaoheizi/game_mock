@import "styles/tokens.wxss";

page { background:var(--color-background); color:var(--color-ink); font-family:var(--font-body); font-size:28rpx; line-height:1.55; --td-brand-color:var(--color-primary); --td-button-primary-bg-color:var(--color-primary); --td-button-primary-border-color:var(--color-primary); --td-button-border-radius:var(--radius-control); }
view,text,button,input,label { box-sizing:border-box; }
button { margin:0; padding:0 28rpx; font:inherit; line-height:1.4; min-height:88rpx; display:flex; align-items:center; justify-content:center; gap:12rpx; border-radius:var(--radius-control); background:transparent; color:inherit; }
button::after { border:none; }
button:not([disabled]) { cursor:pointer; }
button:active:not([disabled]) { opacity:.8; transform:translateY(1rpx); }
button[disabled] { opacity:.48; color:var(--color-muted); background:var(--color-soft); cursor:default; }
button:focus-visible,input:focus-visible { outline:4rpx solid var(--color-focus); outline-offset:5rpx; }
.page { padding:32rpx var(--space-page) calc(44rpx + env(safe-area-inset-bottom)); max-width:1000rpx; margin:0 auto; }
.header { margin:4rpx 0 24rpx; }
.eyebrow { color:var(--color-muted); font-size:20rpx; letter-spacing:3rpx; line-height:1.8; }
.title { font-size:44rpx; line-height:1.3; font-weight:650; letter-spacing:1rpx; }
.subtitle { color:var(--color-muted); font-size:25rpx; line-height:1.65; }
.section-title { font-size:30rpx; font-weight:650; line-height:1.4; }
.row { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.stack { display:flex; flex-direction:column; gap:8rpx; min-width:0; }
.card { background:var(--color-surface); border:1rpx solid var(--color-border); border-radius:var(--radius-card); padding:28rpx; margin-bottom:24rpx; }
.muted { color:var(--color-muted); font-size:24rpx; }.gold { color:var(--color-gold); }
.positive { color:var(--color-primary); }.negative { color:var(--color-danger); }
.number { font-family:var(--font-numeric); font-variant-numeric:tabular-nums; }
.small { font-size:22rpx; }.spaced { margin-top:24rpx; }
.demo-badge { display:inline-flex; align-items:center; color:var(--color-muted); background:var(--color-soft); padding:8rpx 16rpx; border-radius:10rpx; font-size:21rpx; line-height:1.6; }
.badge { display:inline-flex; align-items:center; padding:3rpx 12rpx; border-radius:8rpx; background:var(--color-soft); color:var(--color-primary); font-size:21rpx; white-space:nowrap; }
.primary { background:var(--color-primary); color:var(--color-surface); font-weight:600; }.secondary { background:var(--color-soft); color:var(--color-primary); font-weight:600; }
.primary,.secondary { width:100%; }
.text-button { min-height:88rpx; padding:0 8rpx; font-size:24rpx; color:var(--color-primary); flex-shrink:0; }.danger-button { color:var(--color-danger); }
.primary[disabled] { background:var(--color-primary); color:var(--color-surface); }.secondary[disabled],.text-button[disabled] { background:transparent; }
.empty { padding:40rpx 20rpx; text-align:center; color:var(--color-muted); font-size:25rpx; line-height:1.9; }
.empty-title { font-size:28rpx; color:var(--color-ink); font-weight:600; margin-bottom:8rpx; }
.divider { height:1rpx; background:var(--color-border); margin:26rpx 0; }
.field-label { display:block; font-size:26rpx; font-weight:600; margin-bottom:12rpx; }
.input { background:var(--color-background); border:2rpx solid var(--color-border); border-radius:var(--radius-control); padding:20rpx 24rpx; height:100rpx; width:100%; font-size:30rpx; color:var(--color-ink); }
.input-invalid { border-color:var(--color-danger); }
.field-help { min-height:52rpx; padding-top:10rpx; font-size:23rpx; line-height:1.5; color:var(--color-muted); }.field-help.invalid { color:var(--color-danger); }
.status-line { min-height:48rpx; display:flex; align-items:center; gap:10rpx; font-size:22rpx; color:var(--color-muted); margin-bottom:12rpx; }
.status-dot { width:10rpx; height:10rpx; border-radius:50%; background:var(--color-primary); flex-shrink:0; }.loading-dot { animation:pulse 1s ease-in-out infinite; }
.error-box { background:var(--color-danger-soft); color:var(--color-danger); border:1rpx solid var(--color-danger); padding:20rpx 24rpx; border-radius:var(--radius-control); margin:12rpx 0 24rpx; font-size:24rpx; }.error-box .text-button { color:var(--color-danger); }
.modal-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:100; background:var(--color-overlay); display:flex; align-items:center; justify-content:center; padding:32rpx; }
.modal { background:var(--color-surface); border-radius:var(--radius-dialog); padding:36rpx; width:100%; max-width:800rpx; max-height:calc(100vh - 100rpx - env(safe-area-inset-bottom)); overflow-y:auto; box-shadow:0 24rpx 80rpx rgba(9,29,23,.18); }
.modal .title { font-size:38rpx; }.modal-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.modal-actions { margin-top:24rpx; display:flex; gap:16rpx; }.modal-actions button { flex:1; }
.avatar { height:84rpx; width:84rpx; border-radius:26rpx; display:flex; align-items:center; justify-content:center; background:var(--color-soft); color:var(--color-primary); font-size:36rpx; font-weight:600; flex-shrink:0; }
.footnote { text-align:center; color:var(--color-muted); font-size:21rpx; line-height:1.8; margin-top:32rpx; }.chevron { color:var(--color-muted); font-size:38rpx; margin-left:12rpx; font-weight:400; }
/* 宿主拥有小程序滚动；支持以下声明的 WebView 继承全局基线。 */
page,view { scrollbar-color:var(--color-scrollbar) var(--color-background); scrollbar-width:thin; }
::-webkit-scrollbar { width:6px; height:6px; } ::-webkit-scrollbar-thumb { background:var(--color-scrollbar); border-radius:6px; }
::-webkit-scrollbar-thumb:hover,::-webkit-scrollbar-thumb:active { background:var(--color-muted); } ::-webkit-scrollbar-track { background:var(--color-background); }
@keyframes pulse { 50% { opacity:.3; } }
@media (prefers-reduced-motion:reduce) { .loading-dot { animation:none; } button { transition:none; } }
@media (forced-colors:active) { button,.card,.input { border:1px solid ButtonText; } page,view { scrollbar-color:auto; } }
