page{background:#f5f4ef;color:#193a32;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;--td-brand-color:#176852;--td-button-primary-bg-color:#176852;--td-button-primary-border-color:#176852}
view,text,button,input{box-sizing:border-box}button::after{border:none}button{font-size:28rpx}.page{padding:32rpx 28rpx 56rpx}.eyebrow{font-size:20rpx;letter-spacing:5rpx;color:#a0bcb0}.title{font-size:46rpx;font-weight:700;letter-spacing:2rpx}.subtitle{font-size:24rpx;color:#85938b;line-height:1.8}.section-title{font-size:30rpx;font-weight:650}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.stack{display:flex;flex-direction:column;gap:10rpx}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin-bottom:24rpx;border:1rpx solid #e8ece5}.muted{color:#87968d;font-size:24rpx}.gold{color:#bc9652}.positive{color:#19795b}.negative{color:#bc624e}.demo-badge{display:inline-block;color:#906d2c;background:#f5eacb;border-radius:8rpx;padding:6rpx 12rpx;font-size:20rpx;margin-bottom:20rpx}.badge{padding:4rpx 12rpx;border-radius:10rpx;background:#ecf5ee;color:#267657;font-size:20rpx}.primary{background:#176852;color:#fff;border-radius:16rpx;font-weight:600}.secondary{background:#edf3ee;color:#176852;border-radius:16rpx}.link{color:#176852;font-size:24rpx}.empty{padding:56rpx 20rpx;text-align:center;color:#8d9a92;line-height:1.9}.divider{height:1rpx;background:#eef0ec;margin:24rpx 0}.input{background:#f3f6f1;padding:24rpx;border-radius:14rpx;min-height:88rpx}.modal-mask{position:fixed;inset:0;background:rgba(5,26,21,.6);display:flex;align-items:center;justify-content:center;z-index:100;padding:36rpx}.modal{background:#fffef9;border-radius:32rpx;padding:36rpx;width:100%;max-height:82vh;overflow:auto}.modal .title{font-size:38rpx}.modal-actions{margin-top:28rpx;display:flex;gap:16rpx}.modal-actions button{flex:1}.small{font-size:22rpx}.spaced{margin-top:24rpx}.header{margin:8rpx 0 30rpx}.error-box{background:#fff0e8;color:#a55336;padding:24rpx;border-radius:16rpx;margin-bottom:20rpx;font-size:24rpx}.avatar{width:88rpx;height:88rpx;border-radius:28rpx;background:#e6eee2;color:#34705b;display:flex;align-items:center;justify-content:center;font-size:38rpx;font-weight:650;flex-shrink:0}.footnote{text-align:center;color:#9ba49b;font-size:21rpx;margin-top:30rpx;line-height:1.8}
