.wallet-card { background:var(--color-felt); color:var(--color-on-felt); padding:32rpx; border-radius:var(--radius-card); margin-bottom:24rpx; }
.wallet-label { font-size:26rpx; color:var(--color-on-felt-muted); }.wallet-stamp { border:1rpx solid var(--color-on-felt-muted); color:var(--color-on-felt-muted); font-size:18rpx; letter-spacing:3rpx; padding:6rpx 12rpx; border-radius:8rpx; }
.wallet-balance { font-size:84rpx; font-weight:600; line-height:1.4; margin:8rpx 0 16rpx; overflow-wrap:anywhere; }.wallet-footer { font-size:21rpx; color:var(--color-on-felt-muted); border-top:1rpx solid rgba(255,255,255,.14); padding-top:20rpx; }
.sign-button { width:auto; flex-shrink:0; min-width:196rpx; padding:0 22rpx; font-size:26rpx; }.week-dots { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:8rpx; padding:30rpx 0 24rpx; }.day-dot { display:flex; flex-direction:column; align-items:center; gap:8rpx; font-size:20rpx; color:var(--color-muted); }.day-mark { width:60rpx; height:64rpx; border:1rpx solid var(--color-border); border-radius:18rpx 18rpx 12rpx 12rpx; display:flex; align-items:center; justify-content:center; color:var(--color-muted); font-size:26rpx; }.done .day-mark { color:var(--color-surface); background:var(--color-primary); border-color:var(--color-primary); }.done { color:var(--color-primary); }
.streak-row { border-top:1rpx solid var(--color-border); padding-top:20rpx; margin-bottom:6rpx; font-size:24rpx; gap:10rpx; }.reward-quota { display:flex; flex-direction:column; align-items:flex-end; color:var(--color-muted); font-size:20rpx; flex-shrink:0; }.reward-quota .number { font-size:30rpx; color:var(--color-ink); }
.section-heading { margin:34rpx 0 18rpx; }.ledger-card { padding:0 28rpx 12rpx; }.ledger { display:flex; justify-content:space-between; align-items:center; gap:20rpx; padding:26rpx 0; border-bottom:1rpx solid var(--color-border); }.ledger:last-child { border-bottom:none; }.ledger-title { font-size:27rpx; }.ledger-time { font-size:21rpx; }.ledger-right { display:flex; flex-direction:column; text-align:right; gap:6rpx; flex-shrink:0; }.ledger-delta { font-size:34rpx; font-weight:600; }
.ad-modal { text-align:center; }.ad-modal .title { font-size:34rpx; }.ad-countdown { color:var(--color-primary); font-size:100rpx; line-height:1.2; padding-top:40rpx; }.countdown-label { color:var(--color-muted); font-size:24rpx; margin-top:8rpx; }.ad-close { width:100%; margin-top:12rpx; }
