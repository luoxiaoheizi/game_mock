.wallet-card{background:linear-gradient(120deg,#163f33,#2c5e45);color:#dee8d7;padding:34rpx;border-radius:26rpx;margin-bottom:26rpx;box-shadow:0 16rpx 28rpx #163f3318}.wallet-symbol{font-size:48rpx;color:#d4b671}.wallet-balance{font-size:88rpx;letter-spacing:3rpx;color:#f3e7c9;margin:10rpx 0 28rpx;font-weight:600}.wallet-footer{border-top:1rpx solid #ffffff20;padding-top:22rpx;font-size:21rpx;color:#b5c5ae}.reward-icon{height:76rpx;width:76rpx;background:#faf0d7;color:#b68b34;border-radius:22rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx;flex-shrink:0}.video-icon{background:#e9f1e5;color:#467559;font-size:30rpx}.reward-copy{flex:1}.week-dots{display:flex;justify-content:space-between;margin:30rpx 0}.day-dot{display:flex;flex-direction:column;align-items:center;gap:10rpx;color:#95a18f;font-size:20rpx}.day-dot text:first-child{display:flex;align-items:center;justify-content:center;width:58rpx;height:58rpx;border-radius:50%;background:#f2f4ed;font-size:25rpx}.day-dot.done text:first-child{background:#dcebd6;color:#39704c}.ledger{display:flex;justify-content:space-between;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #edf0e9}.ledger:last-child{border:0}.ledger-time{margin-top:9rpx;font-size:21rpx}.ledger-delta{font-size:32rpx;font-weight:600}.ad-modal{text-align:center}.ad-art{font-size:100rpx;color:#ba9d61;background:#ecf2e7;border-radius:28rpx;padding:30rpx;margin:24rpx 0}.ad-countdown{font-size:70rpx;color:#b18b41;margin:36rpx 0}
