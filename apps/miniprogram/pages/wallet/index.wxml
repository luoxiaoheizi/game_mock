<view class="page" aria-hidden="{{showAd}}">
  <view class="header"><view class="eyebrow">DICE CLUB / WALLET</view><view class="title">积分钱包</view><view class="subtitle">每天积攒一点，随时回来玩一局。</view></view>
  <view class="status-line"><view class="status-dot {{loading ? 'loading-dot' : ''}}"></view><text>{{loading ? '正在更新积分…' : demo ? '本地演示 · 不接真实广告' : '积分与云端同步'}}</text></view>
  <view wx:if="{{error}}" class="error-box row"><text>{{error}}</text><button class="text-button" bindtap="load" disabled="{{loading}}">重试</button></view>
  <view class="wallet-card"><view class="row"><text class="wallet-label">可用积分</text><view class="wallet-stamp">POINTS</view></view><view class="wallet-balance number">{{ready ? balance : '—'}}</view><view class="wallet-footer">仅用于游戏体验 · 不可充值、提现或转让</view></view>
  <view class="card"><view class="row"><view class="stack"><view class="section-title">每日签到</view><view class="subtitle">{{rewards.signed ? '今日已领' : '今日可领'}} <text class="positive">{{ready ? '+' + rewards.dailyAmount : '—'}}</text> 积分</view><view class="small muted">连续签到第 {{ready ? rewards.dailyDay : '—'}} 天</view></view><button class="primary sign-button" disabled="{{busy || rewards.signed || !ready}}" bindtap="sign">{{rewards.signed ? '今日已签到' : '签到领取'}}</button></view>
    <view class="week-dots"><view wx:for="{{rewards.dailyPreview}}" wx:key="day" class="day-dot {{item.claimed ? 'done' : ''}} {{item.day === rewards.dailyDay ? 'current-day' : ''}}"><view class="day-mark number">+{{item.amount}}</view><text>第 {{item.day}} 天</text><text class="day-state">{{item.claimed ? '已领' : item.day === rewards.dailyDay ? '今日' : '待签到'}}</text></view></view>
    <view class="row streak-row"><text>连续签到 <text class="number positive">{{rewards.streak}}</text> 天</text><text class="small muted">北京时间 00:00 更新</text></view><view class="small muted">{{rewards.signed ? '明日连续签到可领 ' + rewards.nextDailyAmount + ' 积分。' : '连续签到解锁不同奖励。'}}断签后从第 1 天重新计算。</view>
    <button class="text-button reward-rules-toggle" bindtap="toggleSignRules" disabled="{{!ready}}" aria-expanded="{{signRulesOpen}}">{{signRulesOpen ? '收起奖励表' : '查看完整签到奖励'}}<text>{{signRulesOpen ? '−' : '+'}}</text></button>
    <view wx:if="{{signRulesOpen}}" class="sign-rules"><view class="small muted">第 1～30 天 · 单位：积分</view><view class="reward-calendar"><view wx:for="{{first30Rewards}}" wx:key="day" class="calendar-day"><text>第 {{item.day}} 天</text><text class="number">+{{item.amount}}</text></view></view><view class="small muted">第 31 天起每天 {{rules.signIn.after30}} 积分，下列天数享专属奖励：</view><view wx:for="{{milestoneRewards}}" wx:key="day" class="milestone-row"><text>第 {{item.day}} 天</text><text class="number">+{{item.amount}}</text></view><view class="small muted">第 101 天起继续每天 {{rules.signIn.after30}} 积分，不重新开始周期。</view></view>
  </view>
  <view class="card"><view class="row"><view class="stack"><view class="section-title">{{demo ? '模拟视频奖励' : '观看视频得积分'}}</view><view class="subtitle">{{rewards.adCount >= rules.adDailyLimit ? '今日奖励已领完，明天再来' : '下次完整观看'}} <text wx:if="{{rewards.adCount < rules.adDailyLimit}}" class="positive">{{ready ? '+' + rewards.adNextAmount + ' 积分' : '—'}}</text></view></view><view class="reward-quota"><text class="number">{{rewards.adCount}} / {{rules.adDailyLimit}}</text><text>今日已领取</text></view></view>
    <view class="ad-steps"><view wx:for="{{adSteps}}" wx:key="amount" class="ad-step {{item.claimed ? 'claimed' : ''}}"><text class="small muted">第 {{index + 1}} 次</text><text class="number">+{{item.amount}}</text><text class="small">{{item.claimed ? '已领' : index === rewards.adCount ? '下一次' : '待领取'}}</text></view></view>
    <button class="secondary spaced" disabled="{{busy || !rewards.adEnabled || rewards.adCount >= rules.adDailyLimit || !ready}}" loading="{{busy &amp;&amp; !showAd}}" bindtap="watch">{{!rewards.adEnabled ? '广告暂未开放' : rewards.adCount >= rules.adDailyLimit ? '今日奖励已领完' : demo ? '开始模拟观看 · 6 秒' : '观看激励视频'}}</button>
    <view class="small muted spaced">{{demo ? '演示倒计时，不加载真实广告。提前关闭或离开页面不送积分。' : '自愿观看，提前关闭不送积分；无广告时可稍后再试。'}}</view><button wx:if="{{pendingAd}}" class="secondary spaced" bindtap="recoverAd" disabled="{{busy}}">确认上一笔广告奖励</button>
  </view>
  <view class="card"><view class="section-title">分享给好友或群聊</view><view class="subtitle spaced">每次分享后自行确认 <text class="positive">+{{rules.shareReward}}</text> 积分，不限次数。</view><view class="small muted spaced">分享返回后，请如实确认是否已发送。取消分享不自动发奖。</view>
    <button wx:if="{{!pendingShare}}" class="secondary spaced" open-type="share" disabled="{{busy || !ready}}">分享给好友或群聊</button>
    <view wx:else><view class="small muted spaced">{{shareConfirmed ? '上次领取结果待确认，请重试查询到账结果。' : '已发送给好友或群聊后，再点击下方按钮领取。'}}</view><button class="primary spaced" bindtap="confirmShare" disabled="{{busy || !ready}}" loading="{{busy}}">{{shareConfirmed ? '重试确认到账' : '已分享，领取 ' + rules.shareReward + ' 分'}}</button><button wx:if="{{!shareConfirmed}}" class="text-button spaced" bindtap="cancelShare" disabled="{{busy}}">未分享，取消领取</button></view>
    <view wx:if="{{demo}}" class="small muted spaced">本地演示奖励保存在本机，不验证微信发送结果。</view>
  </view>
  <view class="row section-heading"><text class="section-title">积分明细</text><text class="small muted">按时间倒序</text></view>
  <view class="card ledger-card"><view wx:if="{{!ledgers.length}}" class="empty">{{loading ? '正在读取积分明细…' : '暂无积分明细，签到领取第一份奖励吧。'}}</view><view wx:for="{{ledgers}}" wx:key="seq" class="ledger"><view class="stack"><view class="ledger-title">{{item.title}}</view><view class="muted ledger-time">{{item.time}}</view></view><view class="ledger-right"><text class="ledger-delta number {{item.delta > 0 ? 'positive' : 'negative'}}">{{item.deltaText}}</text><text class="small muted">余额 {{item.balanceAfter}}</text></view></view><button wx:if="{{cursor}}" class="secondary spaced" bindtap="more" loading="{{loadingMore}}" disabled="{{loadingMore}}">加载更多</button></view>
  <view class="footnote">每一笔都有记录，积分无现金价值。</view>
</view>
<view wx:if="{{showAd}}" class="modal-mask" catchtouchmove="noop"><view class="modal ad-modal" aria-role="dialog" aria-label="模拟视频奖励"><view class="demo-badge">本地模拟 · 无真实广告内容</view><view class="title spaced">留一点时间，领一份积分</view><view class="ad-countdown number">{{remaining ? remaining : '+' + adAmount}}</view><view class="countdown-label">{{remaining ? '秒后可领取' : '积分待领取'}}</view><view class="subtitle spaced">{{remaining ? '请保持当前页面，倒计时结束后领取演示积分。' : '模拟观看已完成，点击下方按钮领取。'}}</view><button class="primary spaced" disabled="{{remaining > 0}}" bindtap="completeDemo">{{remaining ? '模拟观看中…' : '领取 ' + adAmount + ' 积分'}}</button><button class="text-button ad-close" bindtap="cancelDemo">关闭，不领取</button></view></view>
