.rank-summary { display:flex; justify-content:space-between; align-items:center; border-bottom:1rpx solid var(--color-border); padding:16rpx 0 26rpx; gap:24rpx; }.my-rank { font-size:78rpx; font-weight:600; line-height:1.3; color:var(--color-primary); }.summary-right { text-align:right; }.summary-count { font-size:27rpx; margin-bottom:10rpx; }.summary-count .number { font-size:34rpx; }
.rank-heading { margin-top:10rpx; }.rank-list { padding:0; overflow:hidden; margin-bottom:14rpx; }.rank-row { display:flex; align-items:center; gap:16rpx; padding:26rpx 22rpx; border-bottom:1rpx solid var(--color-border); min-height:128rpx; }.rank-row:last-child { border-bottom:none; }.rank-row.me { background:var(--color-soft); }.rank-num { width:28rpx; flex-shrink:0; text-align:center; font-size:28rpx; color:var(--color-muted); }.rank-1 { color:var(--color-primary); font-weight:700; }.rank-row .avatar { width:72rpx; height:72rpx; font-size:30rpx; border-radius:24rpx; background:var(--color-background); }.rank-name { flex:1; min-width:0; display:flex; align-items:flex-start; flex-direction:column; gap:4rpx; }.nickname { font-size:27rpx; overflow-wrap:anywhere; }.rank-points { font-size:34rpx; text-align:right; font-weight:600; flex-shrink:0; }.rank-points text { display:block; font-family:var(--font-body); font-size:20rpx; color:var(--color-muted); font-weight:400; }.remove-button { padding:0; font-size:23rpx; min-width:70rpx; }
.rank-updated { margin-bottom:32rpx; }.invite-token { background:var(--color-background); border:1rpx dashed var(--color-border); border-radius:var(--radius-control); padding:24rpx; font-size:27rpx; text-align:center; overflow-wrap:anywhere; }.invite-actions { display:flex; gap:16rpx; }.invite-actions button { flex:1; font-size:25rpx; padding:0 12rpx; }
