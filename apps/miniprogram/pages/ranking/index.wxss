.rank-summary{display:flex;align-items:center;justify-content:space-between;background:#e6ecdf;border-radius:24rpx;padding:28rpx 32rpx;margin-bottom:26rpx}.my-rank{font-size:68rpx;font-weight:600;color:#3c674f}.rank-decoration{font-size:100rpx;color:#b9cbb0}.summary-right{text-align:right;font-size:24rpx}.rank-list{padding:12rpx}.rank-row{display:flex;align-items:center;gap:16rpx;padding:25rpx 12rpx;border-radius:16rpx}.rank-row+.rank-row{border-top:1rpx solid #eef0ea}.rank-row.me{background:#f3f5e9}.rank-num{font-size:32rpx;width:42rpx;text-align:center}.rank-row .avatar{width:68rpx;height:68rpx;border-radius:22rpx;font-size:30rpx}.rank-name{flex:1;display:flex;align-items:center;gap:8rpx;font-size:27rpx;min-width:0;word-break:break-all}.rank-points{font-size:32rpx;font-weight:600;display:flex;flex-direction:column;align-items:flex-end}.rank-points text{font-size:18rpx;font-weight:400;color:#97a18f;margin-top:3rpx}.invite-token{word-break:break-all;background:#f0f3eb;border-radius:12rpx;padding:22rpx;font-family:monospace;font-size:24rpx}.row button{flex:1}
