<view class="page">
  <view class="header"><view class="eyebrow">DICE CLUB / FRIENDS</view><view class="title">好友排行榜</view><view class="subtitle">看整局胜率，也看累计投入。</view></view>
  <view class="ranking-tabs"><button class="ranking-tab {{board === 'winRate' ? 'active' : ''}}" data-board="winRate" bindtap="changeBoard" aria-pressed="{{board === 'winRate'}}">胜率榜</button><button class="ranking-tab {{board === 'turnover' ? 'active' : ''}}" data-board="turnover" bindtap="changeBoard" aria-pressed="{{board === 'turnover'}}">流水榜</button></view>
  <view class="status-line"><view class="status-dot {{loading ? 'loading-dot' : ''}}"></view><text>{{loading ? '正在更新排行…' : demo ? '本地演示 · 含 2 位示例好友' : '只展示你与游戏好友'}}</text></view>
  <view wx:if="{{error}}" class="error-box row"><text>{{error}}</text><button class="text-button" bindtap="load" disabled="{{loading}}">重试</button></view>
  <view class="rank-summary"><view><view class="small muted">我的{{board === 'winRate' ? '胜率' : '流水'}}名次</view><view class="my-rank number">{{myRank ? '#' + myRank : '—'}}</view><view wx:if="{{ready &amp;&amp; !myRank}}" class="small muted">完成一局后上榜</view></view><view class="summary-right"><view class="summary-count"><text class="number">{{ready ? rankedCount : '—'}}</text> 人已上榜</view><view class="small muted">{{board === 'winRate' ? '按整局盈利胜率排序' : '按累计下注积分排序'}}</view></view></view>
  <view class="small muted ranking-rule">{{board === 'winRate' ? '胜率＝净盈利局数 ÷ 总局数；持平和净亏不算胜。胜率相同，局数多的在前。' : '流水＝所有已结算对局的下注积分总额；不含返还、签到、广告和分享奖励。'}}统计全部历史对局，未玩过暂不上榜。</view>
  <view class="row rank-heading"><text class="section-title">{{board === 'winRate' ? '胜率排行' : '流水排行'}}</text><button class="text-button" bindtap="manage" disabled="{{!ready || busy}}">{{managing ? '完成管理' : '管理好友'}}</button></view>
  <view class="card rank-list"><view wx:for="{{items}}" wx:key="userId" class="rank-row {{item.isMe ? 'me' : ''}}"><text class="rank-num number rank-{{item.rank}}">{{item.rank || '—'}}</text><view class="avatar">{{item.initial}}</view><view class="rank-name"><view class="nickname">{{item.nickname}}</view><text wx:if="{{item.isMe}}" class="badge">我</text><text class="small muted">{{item.rounds ? board === 'winRate' ? item.profitWins + ' 胜 / ' + item.rounds + ' 局' : '累计 ' + item.rounds + ' 局' : '未上榜'}}</text></view><view class="rank-points number">{{item.metric}}<text>{{board === 'winRate' ? '胜率' : '下注积分'}}</text></view><button wx:if="{{managing &amp;&amp; !item.isMe}}" class="text-button danger-button remove-button" data-id="{{item.userId}}" bindtap="remove" disabled="{{busy}}" aria-label="移除好友{{item.nickname}}">移除</button></view><view wx:if="{{items.length <= 1}}" class="empty">{{loading ? '正在读取好友排行…' : '邀请第一位好友，让排行榜热闹起来。'}}</view></view>
  <view class="small muted rank-updated">{{asOf ? asOf + ' 更新 · 下拉刷新' : '加载后显示最近更新时间'}}</view>
  <view wx:if="{{pendingShare}}" class="card"><view class="section-title">分享奖励待确认</view><view class="subtitle spaced">分享返回后，到钱包自行确认领取；取消分享可取消领取。</view><button class="secondary spaced" bindtap="rewardWallet">去钱包确认分享</button></view>
  <view class="card invite-card"><view class="section-title">邀请朋友来玩</view><view class="subtitle spaced">一份邀请，一位新朋友。邀请码 24 小时内有效。</view><button class="primary spaced" disabled="{{busy || !ready}}" loading="{{busy}}" bindtap="create">{{invite ? '重新生成邀请' : '生成邀请'}}</button><view wx:if="{{invite}}"><view class="invite-token number spaced" selectable>{{invite}}</view><view class="invite-actions spaced"><button class="secondary" bindtap="copy">复制邀请码</button><button class="secondary" open-type="share">分享给朋友</button></view></view><view wx:if="{{demo}}" class="small muted spaced">演示好友不代表微信好友。数据保存在本机，跨用户邀请需接入云端。</view></view>
  <view class="card"><view class="section-title">已有邀请码？</view><label class="field-label spaced" for="invite-code">朋友的邀请码</label><input id="invite-code" class="input {{inviteError ? 'input-invalid' : ''}}" placeholder="在这里粘贴邀请码" value="{{incoming}}" bindinput="input" maxlength="100" disabled="{{busy}}" aria-label="朋友的邀请码"/><view class="field-help {{inviteError ? 'invalid' : ''}}" aria-live="polite">{{inviteError || '接受邀请后，双方会出现在彼此的排行榜。'}}</view><button class="secondary spaced" disabled="{{busy || !incoming || !ready}}" loading="{{busy}}" bindtap="accept">接受邀请</button></view>
</view>
