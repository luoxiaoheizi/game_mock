page { background:#241d17; }
.table-page { --table-green:#08633f; --table-deep:#03432d; --table-print:#ead9a5; --table-line:rgba(230,206,141,.58); --table-wood:#3b251a; --table-red:#962e2a; min-height:100vh; padding-bottom:256rpx; background:var(--table-wood); color:var(--table-print); }
.wood-rail { padding:0 14rpx; background:linear-gradient(90deg,#1e1712,#68452d 1%,#38261c 2%,#30231a 98%,#795435 99%,#1a140e); }
.table-felt { min-height:100vh; padding:0 20rpx 26rpx; border-left:2rpx solid #a47f42; border-right:2rpx solid #a47f42; background:repeating-linear-gradient(12deg,rgba(244,240,202,.018) 0,rgba(244,240,202,.018) 1rpx,transparent 1rpx,transparent 4rpx),repeating-linear-gradient(102deg,rgba(0,0,0,.025) 0,rgba(0,0,0,.025) 1rpx,transparent 1rpx,transparent 3rpx),radial-gradient(ellipse at 50% 18%,#12865a 0,#076a46 38%,#044b32 100%); box-shadow:inset 0 0 38rpx rgba(0,0,0,.45); }
.room-header { height:76rpx; display:flex; align-items:center; justify-content:space-between; border-bottom:1rpx solid rgba(232,209,147,.2); }.room-brand { font-family:var(--font-display); font-size:34rpx; letter-spacing:4rpx; color:#f4e6ba; }.room-brand text { font-family:var(--font-body); font-size:21rpx; letter-spacing:1rpx; margin-left:18rpx; color:#d6d6b0; }.room-rules { color:var(--table-print); min-height:76rpx; padding:0 8rpx; font-size:23rpx; }
.cup-scene { height:340rpx; position:relative; perspective:900rpx; }.table-stamp { position:absolute; top:58rpx; left:10rpx; width:96rpx; text-align:center; color:rgba(243,219,160,.44); transform:rotate(-7deg); }.table-stamp text { display:block; font-family:var(--font-display); font-size:33rpx; letter-spacing:8rpx; }.table-stamp text+text { font-family:var(--font-body); font-size:15rpx; letter-spacing:4rpx; margin-top:8rpx; }
.cup-shadow { position:absolute; width:382rpx; height:72rpx; border-radius:50%; left:50%; bottom:48rpx; transform:translateX(-50%); background:radial-gradient(ellipse,rgba(0,0,0,.65),transparent 68%); }
.cup-group { position:absolute; width:354rpx; height:282rpx; left:50%; margin-left:-177rpx; top:8rpx; transform-origin:50% 86%; }
.cup-foot { position:absolute; left:-12rpx; bottom:0; width:378rpx; height:88rpx; border-radius:50%; background:linear-gradient(#837148,#342a1c 40%,#171c17 67%,#957943 69%,#5c4928 77%,#242119 80%); border:2rpx solid #b5985d; box-shadow:0 9rpx 0 #292419,0 17rpx 15rpx rgba(0,0,0,.3); }
.cup-floor { position:absolute; z-index:1; bottom:22rpx; left:4rpx; right:4rpx; height:68rpx; border-radius:50%; background:radial-gradient(ellipse,#224936,#102e23 75%); border:3rpx solid #bdac74; box-shadow:inset 0 5rpx 12rpx rgba(0,0,0,.4); }
.glass-back,.glass-front { position:absolute; left:6rpx; right:6rpx; top:22rpx; bottom:40rpx; border-radius:42% 42% 22% 22% / 22% 22% 13% 13%; border:2rpx solid rgba(217,248,228,.5); }
.glass-back { z-index:1; background:linear-gradient(100deg,rgba(214,255,234,.12),rgba(94,178,141,.05) 26%,rgba(143,225,189,.08) 74%,rgba(220,255,234,.2)); box-shadow:inset 0 0 20rpx rgba(221,255,243,.1); }
.glass-front { z-index:4; overflow:hidden; background:linear-gradient(100deg,rgba(233,255,246,.22),transparent 17%,transparent 68%,rgba(210,251,230,.13) 84%,rgba(233,255,248,.25)); border-left:3rpx solid rgba(230,255,242,.7); border-right:3rpx solid rgba(230,255,242,.64); box-shadow:inset 7rpx 0 8rpx rgba(228,255,241,.08),inset -7rpx 0 8rpx rgba(228,255,241,.11); pointer-events:none; }
.glass-top { position:absolute; left:18rpx; right:18rpx; top:12rpx; height:58rpx; z-index:5; border-radius:50%; border:3rpx solid rgba(227,251,237,.73); background:linear-gradient(165deg,rgba(239,255,245,.27),rgba(185,233,209,.04) 52%,rgba(230,255,245,.13)); box-shadow:0 4rpx 0 rgba(228,255,241,.15),inset 0 4rpx 4rpx rgba(246,255,237,.15); }
.glass-lip { position:absolute; left:5rpx; right:5rpx; height:66rpx; bottom:37rpx; border-radius:50%; border-bottom:4rpx solid rgba(230,251,225,.62); border-left:2rpx solid rgba(229,255,240,.45); border-right:2rpx solid rgba(229,255,240,.45); z-index:5; pointer-events:none; }
.glass-shine { position:absolute; background:linear-gradient(180deg,transparent,rgba(242,255,246,.7),rgba(231,255,240,.2),transparent); width:13rpx; border-radius:50%; transform:rotate(3deg); }.shine-left { top:48rpx; bottom:35rpx; left:23rpx; }.shine-right { top:30rpx; bottom:48rpx; right:22rpx; width:6rpx; opacity:.65; }
.dice-enclosure { position:absolute; z-index:3; inset:60rpx 18rpx 42rpx; overflow:hidden; border-radius:28% 28% 12% 12%; --dice-size:62rpx; }
.die-seat { position:absolute; top:98rpx; width:62rpx; height:62rpx; }.seat-0 { left:44rpx; transform:rotate(-10deg); }.seat-1 { left:132rpx; top:77rpx; transform:rotate(12deg); }.seat-2 { left:219rpx; top:106rpx; transform:rotate(9deg); }
.phase-shaking .cup-group { animation:cup-shake .3s ease-in-out infinite; }.phase-shaking .die-seat { animation:die-bounce .45s ease-in-out infinite; }.phase-shaking .seat-1 { animation-delay:-.15s; animation-direction:reverse; }.phase-shaking .seat-2 { animation-delay:-.28s; }
.phase-settling .die-seat { animation:die-land .32s ease-out both; }.scene-caption { position:absolute; left:0; right:0; bottom:0; text-align:center; min-height:40rpx; font-size:22rpx; color:#eee1b6; letter-spacing:2rpx; }
@keyframes cup-shake { 0%,100% { transform:translateX(-7rpx) rotate(-3deg); } 50% { transform:translateX(7rpx) translateY(-6rpx) rotate(3deg); } }
@keyframes die-bounce { 0%,100% { transform:translate(0,0) rotate(-8deg); } 25% { transform:translate(15rpx,-54rpx) rotate(18deg); } 55% { transform:translate(-12rpx,-74rpx) rotate(-23deg); } 78% { transform:translate(8rpx,-16rpx) rotate(12deg); } }
@keyframes die-land { from { transform:translateY(-20rpx); } 65% { transform:translateY(3rpx); } to { transform:translateY(0); } }
.table-message { margin:8rpx 0 10rpx; min-height:66rpx; border-top:1rpx solid rgba(236,218,163,.25); border-bottom:1rpx solid rgba(236,218,163,.25); }.table-notice { min-height:66rpx; display:flex; align-items:center; justify-content:center; font-size:21rpx; color:#c8d5b9; }.round-banner { display:flex; align-items:center; gap:10rpx; min-height:66rpx; }.round-points { display:flex; align-items:center; gap:7rpx; font-size:22rpx; flex:1; }.result-point { display:inline-flex; align-items:center; justify-content:center; background:#f0e3bc; color:#283927; width:30rpx; height:32rpx; border-radius:4rpx; font-size:22rpx; }.round-net { font-size:27rpx; color:#fff0ac; white-space:nowrap; }.detail-link { padding:0 4rpx; min-height:66rpx; color:#f6e6b4; font-size:21rpx; }.table-detail { padding:20rpx 14rpx; background:rgba(0,0,0,.18); border-bottom:1rpx solid var(--table-line); font-size:24rpx; }.table-detail .row { padding:9rpx 0; }
.table-section-title { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:16rpx 1rpx 10rpx; font-size:24rpx; color:#f3e5b6; }.table-section-title text+text { font-size:19rpx; color:#c7d4b4; }
.printed-grid { display:grid; gap:0; border:1rpx solid var(--table-line); border-radius:8rpx; overflow:visible; }.table-bet { position:relative; display:flex; flex-direction:column; gap:0; padding:8rpx 3rpx; min-width:0; min-height:104rpx; border-radius:0; border:1rpx solid var(--table-line); background:rgba(4,49,32,.09); color:var(--table-print); }
.table-bet[disabled] { opacity:1; background:rgba(1,37,23,.16); color:var(--table-print); }.table-bet.chosen { background:rgba(239,205,101,.16); box-shadow:inset 0 0 0 2rpx #eed783; }.table-bet.hit { background:rgba(247,213,100,.28); box-shadow:inset 0 0 0 3rpx #ffe39a,0 0 18rpx rgba(255,220,111,.2); }
.major-bets { grid-template-columns:1fr 1.16fr 1fr; }.major-bets .table-bet { min-height:124rpx; }.major-label { font-family:var(--font-display); font-size:58rpx; line-height:1.12; font-weight:600; }.major-bets .table-bet:nth-child(2) .major-label { font-size:34rpx; line-height:1.65; }.bet-odds { font-size:20rpx; color:#dbd7ae; line-height:1.4; }.single-bets,.triple-bets { grid-template-columns:repeat(6,minmax(0,1fr)); }.single-bets .table-bet { min-height:112rpx; }.printed-die { width:48rpx; height:48rpx; position:relative; margin:4rpx 0 10rpx; }.printed-die dice-face { position:absolute; left:0; top:0; transform:scale(.46); transform-origin:0 0; }.single-label { font-size:20rpx; }.sum-bets { grid-template-columns:repeat(7,minmax(0,1fr)); }.sum-bets .table-bet { min-height:92rpx; }.sum-value { font-size:37rpx; line-height:1.2; }.sum-bets .bet-odds { font-size:18rpx; }.triple-bets .table-bet { min-height:94rpx; }.triple-value { display:flex; align-items:center; gap:3rpx; font-size:24rpx; }.triple-value>text { margin-top:-20rpx; }
.table-chip { position:absolute; right:5rpx; bottom:8rpx; min-width:47rpx; height:47rpx; padding:0 5rpx; border-radius:50%; background:radial-gradient(circle,#f9e8b3 0,#ead18b 63%,#e1b963 64%); color:#563719; border:4rpx dashed #9b4230; outline:1rpx solid #f5d58d; box-shadow:0 3rpx 0 #8c6232,0 5rpx 6rpx rgba(0,0,0,.3); display:flex; align-items:center; justify-content:center; z-index:2; }.table-chip text { font-size:22rpx; font-weight:700; }.settled-chip { opacity:.72; }.win-tag { position:absolute; left:4rpx; top:3rpx; font-size:18rpx; color:#fff4b9; }
.table-selection { border-bottom:1rpx solid var(--table-line); margin-top:12rpx; font-size:23rpx; }.table-clear { min-height:72rpx; padding:0; font-size:23rpx; color:#f0e2b7; }.selected-row { display:flex; justify-content:space-between; align-items:center; }.selected-row>view { display:flex; align-items:center; gap:16rpx; }.selected-row button { color:#f0e2b7; min-width:88rpx; min-height:88rpx; padding:0; font-size:35rpx; }.table-error { background:rgba(91,21,12,.72); color:#fff1d0; padding:14rpx 18rpx; font-size:23rpx; display:flex; align-items:center; justify-content:space-between; gap:12rpx; }.table-error button { font-size:23rpx; color:#fff1d0; min-height:72rpx; padding:0 12rpx; flex-shrink:0; }.table-history { margin-top:18rpx; }.table-empty { padding:28rpx 0; color:#c7d4b4; font-size:23rpx; text-align:center; }.table-record { display:flex; justify-content:space-between; align-items:center; padding:20rpx 0; border-bottom:1rpx solid rgba(229,210,155,.18); gap:16rpx; font-size:25rpx; }.table-record>view { display:flex; align-items:center; gap:16rpx; }.history-dice { font-size:27rpx; }.record-time { color:#bdceb0; font-size:19rpx; }.table-bottom-note { text-align:center; padding:26rpx 0 10rpx; font-size:19rpx; color:#bdceb0; }
.table-console { position:fixed; z-index:20; left:0; right:0; bottom:var(--page-bottom-inset,0px); padding:18rpx 30rpx 22rpx; color:#f0e4c7; background:linear-gradient(#312c22,#211f19); border-top:3rpx solid #8c713f; box-shadow:0 -10rpx 24rpx rgba(0,0,0,.25); }.console-top,.console-bottom { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }.console-top { margin-bottom:14rpx; }.available-balance { display:flex; flex-direction:column; gap:0; font-size:21rpx; color:#c9c1a6; min-width:0; }.available-balance .number { font-size:38rpx; color:#fff0c6; overflow-wrap:anywhere; }.chip-rack { display:flex; gap:20rpx; }.rack-chip { position:relative; width:90rpx; height:90rpx; min-height:90rpx; padding:0; border-radius:50%; background:#244f64; color:#fcf6df; border:7rpx dashed #e3dfc4; box-shadow:0 4rpx 0 #122b36,inset 0 0 0 3rpx #244f64,inset 0 0 0 4rpx #b4bdac; transition:transform .16s; }.rack-chip .number { font-size:29rpx; font-weight:600; }.chip-50 { background:#922e2a; box-shadow:0 4rpx 0 #411b18,inset 0 0 0 3rpx #922e2a,inset 0 0 0 4rpx #bc9e81; }.chip-100 { background:#334732; box-shadow:0 4rpx 0 #172116,inset 0 0 0 3rpx #334732,inset 0 0 0 4rpx #a0a687; }.rack-chip.active { outline:3rpx solid #f1ce78; outline-offset:4rpx; transform:translateY(-4rpx); }.rack-chip[disabled] { color:#eadbb9; background:#3c4536; opacity:.62; }.chip-check { position:absolute; right:-9rpx; bottom:-9rpx; width:28rpx; height:28rpx; border-radius:50%; background:#f4d58c; color:#42331c; font-size:21rpx; display:flex; align-items:center; justify-content:center; }
.wager-total { display:flex; flex-direction:column; font-size:24rpx; gap:3rpx; }.wager-total .number { font-size:33rpx; margin-left:8rpx; }.wager-limit { font-size:19rpx; color:#b8b198; }.shake-button { width:340rpx; min-height:88rpx; padding:0 24rpx; background:linear-gradient(#f0d493,#c79b4f); color:#382913; border:2rpx solid #f5deaa; box-shadow:0 4rpx 0 #7e572b; border-radius:12rpx; font-size:31rpx; font-weight:650; letter-spacing:3rpx; }.shake-button[disabled] { color:#d0c4a7; background:#615a43; border-color:#817253; opacity:1; box-shadow:none; }
@media (max-width:350px) { .record-time { display:none; }.table-section-title text+text { font-size:18rpx; }.shake-button { width:320rpx; }.room-brand text { font-size:20rpx; margin-left:10rpx; } }
@media (prefers-reduced-motion:reduce) { .phase-shaking .cup-group,.phase-shaking .die-seat,.phase-settling .die-seat { animation:none; }.rack-chip { transition:none; } }
