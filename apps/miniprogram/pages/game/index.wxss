.game-page{padding-bottom:30rpx}.table-top{padding:28rpx 30rpx 40rpx;background:radial-gradient(ellipse at 50% 70%,#285849,#102e2a);color:#f4edd9;border-radius:0 0 40rpx 40rpx}.table-title{font-size:48rpx;font-weight:650;margin-top:10rpx;letter-spacing:3rpx}.balance-box{display:flex;flex-direction:column;align-items:flex-end;background:#ffffff0b;border:1rpx solid #ffffff20;border-radius:18rpx;padding:14rpx 24rpx}.balance-caption{color:#aac1b2;font-size:20rpx}.balance-number{font-size:40rpx;font-weight:600;color:#e7cc91}.table-note{display:flex;justify-content:space-between;font-size:20rpx;color:#9bb9a8;margin-top:22rpx}.dice-stage{height:210rpx;display:flex;gap:36rpx;align-items:center;justify-content:center;border-bottom:1rpx solid #ffffff15}.stage-hint{text-align:center;font-size:22rpx;color:#afc1b2;margin-top:24rpx;letter-spacing:2rpx}.bet-area{padding:28rpx 22rpx}.bet-grid{display:grid;gap:10rpx}.major{grid-template-columns:1fr 1.25fr 1fr}.six{grid-template-columns:repeat(6,1fr)}.seven{grid-template-columns:repeat(7,1fr)}.bet-cell{position:relative;background:#fff;border:2rpx solid #e2e7df;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:96rpx;padding:12rpx 4rpx;gap:6rpx}.major .bet-cell{min-height:134rpx}.cell-title{font-size:28rpx;font-weight:650}.major .cell-title{font-size:38rpx}.major .bet-cell:nth-child(2) .cell-title{font-size:30rpx;color:#a8813e}.cell-odds{font-size:18rpx;color:#8a988d}.selected{background:#e7f1e5;border-color:#2a7658;box-shadow:0 3rpx 0 #bad0b7}.stake-tag{position:absolute;right:-4rpx;top:-9rpx;background:#d4af67;color:#3f3625;padding:3rpx 10rpx;border-radius:20rpx;font-size:18rpx;font-weight:bold}.bet-label{display:flex;justify-content:space-between;margin:25rpx 0 13rpx;font-size:24rpx;font-weight:600}.bet-label text+text{font-size:20rpx;color:#8d9a8f;font-weight:400}.triple-cell .cell-title{font-size:20rpx}.controls{margin-top:30rpx;padding:28rpx}.chip-list{display:flex;gap:20rpx}.chip{width:80rpx;height:80rpx;border-radius:50%;border:5rpx dashed #aec3b1;outline:2rpx solid #e0e8dd;background:#f0f4ed;display:flex;align-items:center;justify-content:center;font-size:26rpx;color:#527361}.chip.active{background:#235e49;color:#fff3d0;border-color:#deb973;outline-color:#be9655;transform:translateY(-3rpx)}.stake-total{font-size:40rpx;font-weight:650;margin-top:5rpx}.stake-total text{font-size:22rpx;font-weight:400}.roll-button{margin:0;width:320rpx;background:#caaa67;color:#223b2f;font-weight:650;border-radius:16rpx}.roll-button[disabled]{background:#dedfd2;color:#9aa08f}.history-heading{margin:30rpx 0 20rpx}.history-row{padding:22rpx 0;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #eff1ec}.history-row:last-child{border:0}.history-dice{font-weight:650;letter-spacing:6rpx;margin-right:20rpx}.result-dice{display:flex;justify-content:center;gap:28rpx;margin:50rpx 0 38rpx}.result-net{font-size:64rpx;font-weight:650}.result-net text{font-size:24rpx}.result-item{font-size:24rpx;padding:10rpx 0}
