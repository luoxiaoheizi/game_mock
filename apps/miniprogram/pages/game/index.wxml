<view class="table-page">
  <view class="wood-rail"><view class="table-felt">
    <view class="room-header"><view class="room-brand">骰趣<text>骰宝积分场</text></view><button class="room-rules" bindtap="rules">玩法说明</button></view>
    <view class="cup-scene phase-{{phase}}" aria-label="{{phase === 'shaking' ? '透明骰盅正在摇动，盅内三颗骰子翻滚' : phase === 'waiting' ? '骰盅已停止，等待确认结果' : '透明骰盅内的三颗骰子'}}">
      <view class="table-stamp"><text>骰 寶</text><text>SIC BO</text></view>
      <view class="cup-shadow"></view>
      <view class="cup-group">
        <view class="cup-foot"></view><view class="cup-floor"></view>
        <view class="glass-back"></view><view class="glass-top"></view>
        <view class="dice-enclosure"><view wx:for="{{[0,1,2]}}" wx:key="*this" class="die-seat seat-{{item}}"><dice-face value="{{dice[item]}}" spatial="{{true}}" rolling="{{phase === 'shaking'}}"/></view></view>
        <view class="glass-front"><view class="glass-shine shine-left"></view><view class="glass-shine shine-right"></view></view>
        <view class="glass-lip"></view>
      </view>
      <view class="scene-caption">{{phase === 'shaking' ? '摇盅中 · 请稍候' : phase === 'settling' ? '骰子落定' : phase === 'waiting' ? '等待确认 · 请勿重复下注' : result ? '本局已开奖 · 骰子正面为结果' : '选好筹码，点桌面下注'}}</view>
    </view>
    <view class="table-message" aria-live="polite"><view wx:if="{{result}}" class="round-banner"><view class="round-points"><text wx:for="{{[0,1,2]}}" wx:key="*this" class="number result-point">{{dice[item]}}</text><text>{{result.triple ? '豹子' : result.sum >= 11 ? '大' : '小'}} · {{result.sum}} 点</text></view><text class="round-net number">{{result.netText}} 积分</text><button class="detail-link" bindtap="toggleDetails">{{detailsOpen ? '收起' : '明细'}}</button></view><view wx:else class="table-notice">{{loading ? '正在读取积分与记录…' : demo ? '本地演示 · 仅虚拟积分，不可兑现' : '虚拟积分娱乐 · 每局独立开奖'}}</view></view>
    <view wx:if="{{result &amp;&amp; detailsOpen}}" class="table-detail"><view class="row"><text>投入 {{result.stakeTotal}}</text><text>返还 {{result.payoutTotal}}（含本金）</text></view><view wx:for="{{result.items}}" wx:key="label" class="row"><text>{{item.label}} · {{item.stake}}</text><text>返还 {{item.payout}}</text></view></view>
    <view wx:if="{{error}}" class="table-error"><text>{{error}}</text><button bindtap="load" disabled="{{loading}}">重新加载</button></view>
    <view class="betting-layout">
      <view class="table-section-title"><text>大小 · 豹子</text><text>豹子时，大小均不命中</text></view>
      <view class="printed-grid major-bets"><button wx:for="{{main}}" wx:key="key" class="table-bet {{item.stake ? 'chosen' : ''}} {{item.won ? 'hit' : ''}}" data-key="{{item.key}}" bindtap="add" bindlongpress="subtract" disabled="{{rolling || pending || !ready}}" aria-label="{{item.title}}，净赢{{item.odds}}，已投入{{item.stake}}积分"><text class="major-label">{{item.title}}</text><text class="bet-odds">{{item.odds}}</text><view wx:if="{{item.stake || item.settledStake}}" class="table-chip {{item.settledStake ? 'settled-chip' : ''}}"><text class="number">{{item.stake || item.settledStake}}</text></view><text wx:if="{{item.won}}" class="win-tag">命中</text></button></view>
      <view class="table-section-title"><text>出现某点</text><text>出现 1 / 2 / 3 次，净赢 1 / 2 / 3 倍</text></view>
      <view class="printed-grid single-bets"><button wx:for="{{singles}}" wx:key="key" class="table-bet {{item.stake ? 'chosen' : ''}} {{item.won ? 'hit' : ''}}" data-key="{{item.key}}" bindtap="add" bindlongpress="subtract" disabled="{{rolling || pending || !ready}}" aria-label="{{item.title}}，净赢{{item.odds}}，已投入{{item.stake}}积分，点选加入筹码"><view class="printed-die"><dice-face value="{{item.value}}"/></view><text class="single-label">{{item.value}} 点</text><view wx:if="{{item.stake || item.settledStake}}" class="table-chip {{item.settledStake ? 'settled-chip' : ''}}"><text class="number">{{item.stake || item.settledStake}}</text></view><text wx:if="{{item.won}}" class="win-tag">命中</text></button></view>
      <view class="table-section-title"><text>总点数</text><text>三骰之和 · 格内为净赢倍数</text></view>
      <view class="printed-grid sum-bets"><button wx:for="{{sums}}" wx:key="key" class="table-bet {{item.stake ? 'chosen' : ''}} {{item.won ? 'hit' : ''}}" data-key="{{item.key}}" bindtap="add" bindlongpress="subtract" disabled="{{rolling || pending || !ready}}" aria-label="{{item.title}}，净赢{{item.odds}}，已投入{{item.stake}}积分，点选加入筹码"><text class="sum-value number">{{item.value}}</text><text class="bet-odds">{{item.odds}}</text><view wx:if="{{item.stake || item.settledStake}}" class="table-chip {{item.settledStake ? 'settled-chip' : ''}}"><text class="number">{{item.stake || item.settledStake}}</text></view><text wx:if="{{item.won}}" class="win-tag">命中</text></button></view>
      <view class="table-section-title"><text>指定豹子</text><text>三骰同点 · 净赢 150 倍</text></view>
      <view class="printed-grid triple-bets"><button wx:for="{{triples}}" wx:key="key" class="table-bet {{item.stake ? 'chosen' : ''}} {{item.won ? 'hit' : ''}}" data-key="{{item.key}}" bindtap="add" bindlongpress="subtract" disabled="{{rolling || pending || !ready}}" aria-label="{{item.title}}，净赢{{item.odds}}，已投入{{item.stake}}积分，点选加入筹码"><text class="triple-value number">{{item.value}}<text>{{item.value}}</text>{{item.value}}</text><view wx:if="{{item.stake || item.settledStake}}" class="table-chip {{item.settledStake ? 'settled-chip' : ''}}"><text class="number">{{item.stake || item.settledStake}}</text></view><text wx:if="{{item.won}}" class="win-tag">命中</text></button></view>
    </view>
    <view wx:if="{{selected.length}}" class="table-selection"><view class="row"><text>本局已选 {{selected.length}} 项</text><button class="table-clear" bindtap="clear" disabled="{{rolling || pending}}">清空筹码</button></view><view wx:for="{{selected}}" wx:key="key" class="selected-row"><text>{{item.title}}</text><view><text class="number">{{item.stake}} 积分</text><button data-key="{{item.key}}" bindtap="subtract" disabled="{{rolling || pending}}" aria-label="减少{{item.title}}的{{chip}}积分">−</button></view></view></view>
    <view class="table-history"><view class="table-section-title"><text>最近开奖</text><text>净积分变化</text></view><view wx:if="{{historyError}}" class="table-error"><text>{{historyError}}</text><button bindtap="refreshHistory">重试</button></view><view wx:elif="{{!history.length}}" class="table-empty">还没有记录，摇出你的第一局。</view><view wx:for="{{history}}" wx:key="roundId" class="table-record"><view><text class="number history-dice">{{item.dice[0]}} · {{item.dice[1]}} · {{item.dice[2]}}</text><text>{{item.triple ? '豹子' : item.sum >= 11 ? '大' : '小'}} · {{item.sum}} 点</text><text class="record-time">{{item.time}}</text></view><text class="number">{{item.netText}}</text></view></view>
    <view class="table-bottom-note">轻松玩一局 · 积分不可充值、提现或转让</view>
  </view></view>
  <view class="table-console"><view class="console-top"><view class="available-balance"><text>可用积分</text><text class="number">{{ready ? balance : '—'}}</text></view><view class="chip-rack"><button wx:for="{{chips}}" wx:key="*this" class="rack-chip chip-{{item}} {{chip === item ? 'active' : ''}}" data-value="{{item}}" bindtap="chooseChip" disabled="{{rolling || pending || !ready}}" aria-label="选择{{item}}积分筹码"><text class="number">{{item}}</text><view wx:if="{{chip === item}}" class="chip-check">✓</view></button></view></view><view class="console-bottom"><view class="wager-total"><text>本局投入 <text class="number">{{total}}</text></text><text class="wager-limit">每局上限 500 积分</text></view><button class="shake-button" bindtap="play" disabled="{{rolling || !ready || (!total &amp;&amp; !pending)}}">{{phase === 'shaking' ? '正在摇盅…' : rolling ? '正在确认…' : pending ? '确认本局结果' : '摇盅开奖'}}</button></view></view>
</view>
