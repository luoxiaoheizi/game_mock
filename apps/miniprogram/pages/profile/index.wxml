<view class="page" aria-hidden="{{editing}}">
  <view class="header"><view class="eyebrow">DICE CLUB / PROFILE</view><view class="title">我的</view><view class="subtitle">记录每一掷，也留住每一份好手气。</view></view>
  <view class="status-line"><view class="status-dot {{loading ? 'loading-dot' : ''}}"></view><text>{{loading ? '正在读取资料…' : demo ? '本地演示 · 资料保存在本机' : '个人资料已同步'}}</text></view>
  <view wx:if="{{error}}" class="error-box row"><text>{{error}}</text><button class="text-button" bindtap="load" disabled="{{loading}}">重试</button></view>
  <view class="profile-header"><view class="profile-avatar">{{initial}}</view><view class="profile-identity"><view class="profile-name">{{nickname || '正在读取资料…'}}</view><view class="profile-member">骰趣玩家 · 纯积分娱乐</view></view><button class="edit-name" bindtap="edit" disabled="{{!ready}}">编辑</button></view>
  <view class="card stats"><view><text class="number">{{ready ? wallet.rounds : '—'}}</text><text>投掷局数</text></view><view><text class="number">{{ready ? wallet.wins : '—'}}</text><text>命中局数</text></view><view><text class="number">{{ready ? wallet.totalPayout : '—'}}</text><text>累计返还</text></view></view>
  <view class="section-title settings-title">个人设置</view>
  <view class="card settings"><button class="setting-row" bindtap="edit" disabled="{{!ready}}"><text>我的昵称</text><view class="setting-value"><text class="nickname-value">{{nickname}}</text><text class="chevron">›</text></view></button><button class="setting-row" bindtap="wallet"><text>签到与积分奖励</text><view class="setting-value"><text class="small muted">去领取</text><text class="chevron">›</text></view></button><view class="setting-row"><view><view>开奖震动反馈</view><view class="small muted">开出点数时轻轻提醒</view></view><switch checked="{{haptics}}" color="#205c48" bindchange="toggle" aria-label="开奖震动反馈"/></view><button class="setting-row" bindtap="rules"><text>玩法与积分说明</text><text class="chevron">›</text></button></view>
  <view class="profile-note"><view class="note-mark">骰</view><view class="stack"><view class="note-title">轻松玩一会儿</view><view class="small muted">三颗骰子，一点闲暇。积分只记录游戏体验。</view></view></view>
  <view class="footnote"><view>骰趣 DICE CLUB · 1.0.0</view><view>纯虚拟积分娱乐，不涉及真实钱财</view></view>
</view>
<view wx:if="{{editing}}" class="modal-mask" catchtouchmove="noop"><view class="modal" aria-role="dialog" aria-label="修改昵称"><view class="title">换个喜欢的昵称</view><view class="subtitle spaced">新昵称会同步显示在好友排行榜中。</view><label class="field-label spaced" for="nickname">我的昵称</label><input id="nickname" class="input {{formError ? 'input-invalid' : ''}}" type="nickname" value="{{editName}}" bindinput="input" focus="{{nameFocused}}" disabled="{{busy}}" maxlength="24" placeholder="输入 2～12 个字符" aria-label="我的昵称"/><view class="field-help {{formError ? 'invalid' : ''}}" aria-live="polite">{{formError || '2～12 个字符，支持中文、字母和数字。'}}</view><view class="modal-actions"><button class="secondary" bindtap="close" disabled="{{busy}}">取消</button><button class="primary" bindtap="save" loading="{{busy}}" disabled="{{busy}}">{{busy ? '保存中…' : '保存昵称'}}</button></view></view></view>
