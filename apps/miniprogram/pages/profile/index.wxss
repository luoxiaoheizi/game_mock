.profile-header { display:flex; align-items:center; gap:22rpx; padding:32rpx; background:var(--color-felt); border-radius:var(--radius-card) var(--radius-card) 0 0; color:var(--color-on-felt); min-height:180rpx; }.profile-avatar { width:100rpx; height:100rpx; flex-shrink:0; display:flex; align-items:center; justify-content:center; border-radius:32rpx; background:var(--color-gold-soft); color:var(--color-ink); font-size:44rpx; font-family:var(--font-display); }.profile-identity { flex:1; min-width:0; }.profile-name { font-size:34rpx; font-weight:600; line-height:1.4; overflow-wrap:anywhere; }.profile-member { color:var(--color-on-felt-muted); font-size:21rpx; margin-top:8rpx; }.edit-name { color:var(--color-on-felt); font-size:24rpx; padding:0 6rpx; min-width:72rpx; flex-shrink:0; }
.stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); padding:28rpx 12rpx; border-top:none; border-radius:0 0 var(--radius-card) var(--radius-card); }.stats view { display:flex; flex-direction:column; align-items:center; gap:6rpx; min-width:0; border-right:1rpx solid var(--color-border); }.stats view:last-child { border:none; }.stats text { font-size:23rpx; color:var(--color-muted); }.stats .number { font-size:36rpx; color:var(--color-ink); font-weight:600; max-width:100%; overflow-wrap:anywhere; }
.settings-title { margin:36rpx 0 18rpx; }.settings { padding:0 28rpx; }.setting-row { min-height:114rpx; width:100%; padding:22rpx 0; border-bottom:1rpx solid var(--color-border); border-radius:0; display:flex; justify-content:space-between; align-items:center; gap:22rpx; font-weight:400; font-size:27rpx; text-align:left; }.setting-row:last-child { border-bottom:none; }.setting-value { display:flex; align-items:center; min-width:0; max-width:52%; }.nickname-value { color:var(--color-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:24rpx; }.setting-row switch { flex-shrink:0; }.profile-note { display:flex; align-items:center; gap:20rpx; padding:8rpx 4rpx; }.note-mark { color:var(--color-primary); border:1rpx solid var(--color-border); border-radius:20rpx; width:76rpx; height:76rpx; display:flex; align-items:center; justify-content:center; font-size:36rpx; flex-shrink:0; font-family:var(--font-display); }.note-title { font-size:27rpx; font-family:var(--font-display); }
