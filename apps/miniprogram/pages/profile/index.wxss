.profile-header{display:flex;align-items:center;gap:24rpx;padding:24rpx 0 40rpx}.profile-avatar{background:#dce7d2;color:#3d6c4e;width:118rpx;height:118rpx;border-radius:38rpx;display:flex;align-items:center;justify-content:center;font-size:52rpx;font-weight:650;flex-shrink:0}.profile-name{font-size:38rpx;font-weight:650;word-break:break-all}.edit-name{margin-left:auto;flex-shrink:0;color:#73906e;font-size:24rpx;padding:12rpx}.stats{display:flex;padding:34rpx 14rpx}.stats>view{width:33.333%;display:flex;flex-direction:column;align-items:center;gap:12rpx}.stats>view+view{border-left:1rpx solid #e9ece2}.stats text:first-child{font-size:38rpx;font-weight:650}.stats text+text{font-size:21rpx;color:#8e9a89}.profile-note{padding:28rpx 14rpx 44rpx;line-height:2.1}.profile-note>view+view{font-size:30rpx;margin-top:10rpx}.profile-note>text{font-size:24rpx;color:#8d9a85}.settings{padding:6rpx 28rpx}.setting-row{min-height:108rpx;display:flex;align-items:center;justify-content:space-between;gap:16rpx}.setting-row+.setting-row{border-top:1rpx solid #edf0e7}.chevron{color:#a7b19e;font-size:40rpx;margin-left:16rpx}.setting-row switch{transform:scale(.8);transform-origin:right center}
